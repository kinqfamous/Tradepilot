# ============================================================
# BUILDER SIGNER SECRETS - DO NOT PUT THESE IN THE MAIN .env FILE
# ============================================================
# This file is read ONLY by scripts/register-phoenix-flight-builder.ts,
# a one-time administrative tool. It is NEVER read by the bot process
# (src/index.ts, src/config/env.ts never touch this file or its variable
# names) and is listed in .gitignore.
#
# Why this file exists separately: TradePilot's own security spec (section
# 20) requires that builder private keys are never stored in the app's
# runtime configuration. Putting a private key in the main .env would risk
# it being loaded into the bot process, appearing in logs, or ending up
# committed alongside ordinary config. Keeping it in a file the bot never
# even imports removes that risk entirely.
#
# Usage: copy this file to .env.builder-signer, fill in ONE of the two
# options below, then run:
#   npm run register-builder -- --env-keypair --fee-bps 8
# (or continue using --keypair <path-to-json-file> instead of this file
# at all, if you'd rather keep the key in a local Solana CLI keypair file)
#
# After registration completes, delete this file or move it somewhere
# secure - it has no further purpose once the builder is registered.

# The builder authority's private key, base58-encoded (same format as
# `solana-keygen` / Phoenix wallet exports). This is the account that
# collects TradePilot's fees.
BUILDER_AUTHORITY_PRIVATE_KEY_BASE58=

# Only fill this in if you generated a SEPARATE keypair for the trader
# account the builder rides on (uncommon - in Phoenix's own example the
# builder authority and its trader account are the same wallet). Leave
# blank to reuse BUILDER_AUTHORITY_PRIVATE_KEY_BASE58 for both roles.
BUILDER_TRADER_PRIVATE_KEY_BASE58=
