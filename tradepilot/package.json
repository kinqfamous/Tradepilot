{
  "name": "tradepilot",
  "version": "1.0.0",
  "description": "TradePilot - Telegram-native perpetual trading platform (Phoenix Perps first adapter)",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.mjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "start": "node dist/index.mjs",
    "start:worker": "node dist/worker.mjs",
    "worker": "tsx watch src/queues/worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "register-builder": "tsx scripts/register-phoenix-flight-builder.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ellipsis-labs/rise": "^0.4.67",
    "@prisma/client": "5.20.0",
    "@resvg/resvg-js": "^2.6.2",
    "@solana/web3.js": "1.95.3",
    "axios": "1.7.7",
    "bs58": "5.0.0",
    "bullmq": "5.12.14",
    "dotenv": "16.4.5",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "pino": "9.4.0",
    "pino-pretty": "11.2.2",
    "telegraf": "4.16.3",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.14.10",
    "@types/ws": "8.5.12",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "esbuild": "0.21.5",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "prisma": "5.20.0",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "2.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "node-fetch": {
      "whatwg-url": "14.2.0"
    }
  }
}
