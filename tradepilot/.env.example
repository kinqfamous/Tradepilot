# ============================================================
# TELEGRAM
# ============================================================
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs that get admin commands
TELEGRAM_ADMIN_IDS=
# Bot username without @, used to build referral deep links
TELEGRAM_BOT_USERNAME=@Tradepilot_prepBot

# ============================================================
# DATABASE / CACHE
# ============================================================
DATABASE_URL="postgresql://tradepilot:tradepilot@localhost:5432/tradepilot?schema=public"
REDIS_URL="redis://localhost:6379"

# ============================================================
# SECURITY
# ============================================================
# 32-byte (64 hex char) key for encrypting stored exchange credentials/session secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=
# Signing secret for internal JWTs (linked-account sessions, not exchange auth)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ============================================================
# PHOENIX PERPS (first exchange adapter)
# ============================================================
PHOENIX_REST_URL=https://perp-api.phoenix.trade
PHOENIX_WS_URL=wss://perp-api.phoenix.trade/v1/ws
# Solana RPC used to build/submit transactions for Phoenix trader actions
PHOENIX_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ============================================================
# DEFAULT EXCHANGE
# ============================================================
DEFAULT_EXCHANGE=phoenix

# ============================================================
# TRADING DEFAULTS
# ============================================================
DEFAULT_LEVERAGE=5
DEFAULT_SLIPPAGE_BPS=50
DEFAULT_ORDER_TYPE=market

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_REQUESTS=15

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================================
# QUEUE
# ============================================================
QUEUE_PREFIX=tradepilot
